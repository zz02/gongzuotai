{
  "name": "insprira",
  "version": "0.6.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "password:reset": "bash scripts/reset-password.sh",
    "backup:create": "node scripts/backup.js create",
    "backup:list": "node scripts/backup.js list",
    "backup:verify": "node scripts/backup.js verify",
    "backup:restore": "node scripts/restore-backup.js",
    "service:install": "node scripts/macos-service.js install",
    "service:start": "node scripts/macos-service.js start",
    "service:stop": "node scripts/macos-service.js stop",
    "service:restart": "node scripts/macos-service.js restart",
    "service:status": "node scripts/macos-service.js status",
    "service:logs": "node scripts/macos-service.js logs",
    "service:uninstall": "node scripts/macos-service.js uninstall",
    "release:build": "node scripts/build-release.js",
    "release:candidate": "node scripts/build-release.js --worktree",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind.css --minify",
    "check": "node --check server.js",
    "preflight": "node scripts/preflight.js",
    "skills:sync": "node scripts/sync-creator-skills.js",
    "skills:update": "node scripts/sync-creator-skills.js --update",
    "test": "node --test --test-concurrency=1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "marked": "^15.0.12",
    "playwright": "^1.55.1",
    "rss-parser": "3.13.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
